# Option A: Gemini vision prototype. This is experimental visual gesture estimation,
# NOT a validated Indian Sign Language translation model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Option B: compatible dedicated ISL model service (takes precedence over Gemini).
# Must expose POST /predict_frames_bin and accept the SanketSetu 16-frame binary format.
MODEL_API_BASE_URL=

# Optional location for the local SQLite database.
# SANKETSETU_DB=backend/data/sanketsetu.sqlite3
